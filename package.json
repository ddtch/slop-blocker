{
  "name": "slop-blocker",
  "version": "0.1.0",
  "description": "Browser extension that detects AI-generated content and hides it behind a click-to-reveal warning.",
  "license": "MIT",
  "homepage": "https://github.com/ddtch/slop-blocker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddtch/slop-blocker.git"
  },
  "bugs": {
    "url": "https://github.com/ddtch/slop-blocker/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "icons": "node scripts/gen-icons.mjs",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "shots": "npm run build && node scripts/screenshots.mjs",
    "landing": "node scripts/landing-shot.mjs",
    "privacy": "node scripts/build-privacy.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "check:all": "npm run check && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
